@model List<Advertisement>
@{
    ViewData["Title"] = "Promotional Banners & Advertisements";
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-0">Dynamic Banners & Advertisements CMS</h2>
            <p class="text-muted small">Manage public landing page rotating promotions, target links, and scheduling</p>
        </div>
        <button class="btn btn-btb-primary" data-bs-toggle="modal" data-bs-target="#newBannerModal">
            <i class="bi bi-plus-circle me-1"></i> Add New Banner
        </button>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bank table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Order</th>
                            <th>Banner Details</th>
                            <th>Tag & Badge</th>
                            <th>Target URL</th>
                            <th>Schedule Period</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ad in Model)
                        {
                            <tr>
                                <td class="fw-bold text-primary">#@ad.DisplayOrder</td>
                                <td>
                                    <strong class="text-dark">@ad.Title</strong><br />
                                    <small class="text-muted">@ad.Subtitle</small>
                                </td>
                                <td><span class="badge @ad.BadgeColor">@ad.TagText</span></td>
                                <td class="font-monospace small">@ad.TargetUrl</td>
                                <td class="small text-muted">@ad.StartDate.ToString("dd/MM/yy") - @ad.EndDate.ToString("dd/MM/yy")</td>
                                <td>
                                    <span class="badge @(ad.IsActive ? "bg-success" : "bg-secondary")">
                                        @(ad.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <form asp-action="Toggle" method="post">
                                            <input type="hidden" name="id" value="@ad.AdId" />
                                            <input type="hidden" name="currentStatus" value="@ad.IsActive" />
                                            <button type="submit" class="btn btn-sm btn-outline-secondary" title="Toggle Active">
                                                <i class="bi @(ad.IsActive ? "bi-eye-slash" : "bi-eye")"></i>
                                            </button>
                                        </form>
                                        <form asp-action="Delete" method="post" onsubmit="return confirm('Delete this banner?');">
                                            <input type="hidden" name="id" value="@ad.AdId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- New Banner Modal -->
<div class="modal fade" id="newBannerModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold text-dark"><i class="bi bi-badge-ad text-primary me-2"></i> Create Dynamic Advertisement</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Create" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Banner Title</label>
                        <input type="text" name="Title" class="form-control" placeholder="e.g. Festive Car Loan @@ 8.49%" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Subtitle / Tagline</label>
                        <input type="text" name="Subtitle" class="form-control" placeholder="e.g. 100% on-road funding with zero foreclosing fees" required />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Tag Text</label>
                            <input type="text" name="TagText" class="form-control" value="Limited Offer" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Badge Color</label>
                            <select name="BadgeColor" class="form-select">
                                <option value="bg-primary">Blue (Primary)</option>
                                <option value="bg-success">Green (Success)</option>
                                <option value="bg-warning text-dark">Gold (Warning)</option>
                                <option value="bg-danger">Red (Danger)</option>
                            </select>
                        </div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">CTA Button Text</label>
                            <input type="text" name="CallToActionText" class="form-control" value="Apply Now" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Target URL</label>
                            <input type="text" name="TargetUrl" class="form-control" value="/Customer/Loans" required />
                        </div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-md-4">
                            <label class="form-label fw-bold small">Display Order</label>
                            <input type="number" name="DisplayOrder" class="form-control" value="1" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold small">Start Date</label>
                            <input type="date" name="StartDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold small">End Date</label>
                            <input type="date" name="EndDate" class="form-control" value="@DateTime.Today.AddMonths(6).ToString("yyyy-MM-dd")" required />
                        </div>
                    </div>
                    <input type="hidden" name="ImageUrl" value="/images/banner-generic.jpg" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-btb-primary">Publish Advertisement</button>
                </div>
            </form>
        </div>
    </div>
</div>
