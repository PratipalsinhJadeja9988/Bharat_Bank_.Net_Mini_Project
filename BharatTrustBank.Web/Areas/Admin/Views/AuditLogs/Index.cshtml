@model List<AuditLog>
@{
    ViewData["Title"] = "Security Audit Trails & Activity Logs";
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-0">System Security Audit Logs</h2>
            <p class="text-muted small">Chronological ledger of user logins, financial transactions, approvals, rate changes, and administrative actions</p>
        </div>
        <button onclick="window.print()" class="btn btn-outline-primary">
            <i class="bi bi-printer-fill me-1"></i> Print Audit Trail
        </button>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bank table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Log ID</th>
                            <th>User</th>
                            <th>Role</th>
                            <th>Action Type</th>
                            <th>Description</th>
                            <th>IP Address</th>
                            <th>Timestamp</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var l in Model)
                            {
                                <tr>
                                    <td class="font-monospace text-muted small">#@l.LogId</td>
                                    <td class="fw-bold text-dark">@l.Username</td>
                                    <td>
                                        <span class="badge @(l.Role == "Admin" ? "bg-primary" : (l.Role == "Manager" ? "bg-success" : (l.Role == "Employee" ? "bg-info text-dark" : "bg-warning text-dark")))">
                                            @l.Role
                                        </span>
                                    </td>
                                    <td><span class="badge bg-light text-dark border fw-bold">@l.Action</span></td>
                                    <td class="small text-muted" style="max-width: 400px;">@l.Description</td>
                                    <td class="font-monospace small">@l.IPAddress</td>
                                    <td class="small">@l.Timestamp.ToString("dd MMM yyyy, hh:mm:ss tt")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="7" class="text-center py-4 text-muted">No audit logs found.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
