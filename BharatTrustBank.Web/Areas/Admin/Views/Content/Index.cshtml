@model List<FAQ>
@{
    ViewData["Title"] = "Content CMS (FAQs, Offers & Currencies)";
    var offers = ViewBag.Offers as List<Offer> ?? new List<Offer>();
    var currencies = ViewBag.Currencies as List<CurrencyRate> ?? new List<CurrencyRate>();
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-0">Website Content Management Center</h2>
            <p class="text-muted small">Manage public FAQs, promotional merchant discount offers, and indicative currency rates</p>
        </div>
    </div>

    <!-- Section 1: Manage FAQs -->
    <div class="card shadow-sm mb-5">
        <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
            <h5 class="mb-0 fw-bold"><i class="bi bi-question-circle-fill text-primary me-2"></i> Frequently Asked Questions (FAQs)</h5>
            <button class="btn btn-sm btn-btb-primary" data-bs-toggle="modal" data-bs-target="#newFaqModal">
                <i class="bi bi-plus-lg"></i> Add FAQ
            </button>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bank table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Category</th>
                            <th>Question</th>
                            <th>Answer Snippet</th>
                            <th>Order</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var f in Model)
                        {
                            <tr>
                                <td><span class="badge bg-primary-subtle text-primary">@f.Category</span></td>
                                <td class="fw-bold text-dark">@f.Question</td>
                                <td class="small text-muted" style="max-width: 400px;">@f.Answer</td>
                                <td class="fw-bold">#@f.DisplayOrder</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Section 2: Manage Merchant Offers -->
    <div class="card shadow-sm mb-5">
        <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
            <h5 class="mb-0 fw-bold"><i class="bi bi-tags-fill text-warning me-2"></i> Promotional Offers & Discounts</h5>
            <button class="btn btn-sm btn-btb-gold" data-bs-toggle="modal" data-bs-target="#newOfferModal">
                <i class="bi bi-plus-lg"></i> Add Offer
            </button>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bank table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Title & Category</th>
                            <th>Description</th>
                            <th>Discount Code</th>
                            <th>Valid Till</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var o in offers)
                        {
                            <tr>
                                <td>
                                    <strong>@o.Title</strong><br />
                                    <span class="badge bg-light text-dark border">@o.Category</span>
                                </td>
                                <td class="small text-muted">@o.Description</td>
                                <td><code>@(o.DiscountCode ?? "N/A")</code></td>
                                <td class="small">@o.ValidTill.ToString("dd MMM yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Section 3: Currency Rates Editor -->
    <div class="card shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0 fw-bold"><i class="bi bi-currency-exchange text-success me-2"></i> Currency Exchange Rates Master</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bank table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Currency</th>
                            <th>Buying Rate (INR)</th>
                            <th>Selling Rate (INR)</th>
                            <th>Update Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in currencies)
                        {
                            <tr>
                                <form asp-action="UpdateCurrency" method="post">
                                    <input type="hidden" name="currencyId" value="@c.CurrencyId" />
                                    <td><strong>@c.CurrencyCode</strong> <small class="text-muted">(@c.CurrencyName)</small></td>
                                    <td style="max-width: 140px;">
                                        <input type="number" step="0.01" name="buyRate" class="form-control form-control-sm fw-bold text-success" value="@c.BuyRate" required />
                                    </td>
                                    <td style="max-width: 140px;">
                                        <input type="number" step="0.01" name="sellRate" class="form-control form-control-sm fw-bold text-danger" value="@c.SellRate" required />
                                    </td>
                                    <td>
                                        <button type="submit" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-save"></i> Save Rate
                                        </button>
                                    </td>
                                </form>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Add FAQ Modal -->
<div class="modal fade" id="newFaqModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold text-dark">Add New FAQ</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateFAQ" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Category</label>
                        <select name="Category" class="form-select">
                            <option value="Accounts">Accounts</option>
                            <option value="Transfers">Transfers</option>
                            <option value="Loans">Loans</option>
                            <option value="Deposits">Deposits</option>
                            <option value="Security">Security</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Question</label>
                        <input type="text" name="Question" class="form-control" placeholder="Enter Question" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Detailed Answer</label>
                        <textarea name="Answer" class="form-control" rows="3" placeholder="Enter Answer" required></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Display Order</label>
                        <input type="number" name="DisplayOrder" class="form-control" value="1" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-btb-primary">Save FAQ</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Add Offer Modal -->
<div class="modal fade" id="newOfferModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold text-dark">Add Promotional Offer</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateOffer" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Offer Title</label>
                        <input type="text" name="Title" class="form-control" placeholder="e.g. Zomato 15% Cashback" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Category</label>
                        <input type="text" name="Category" class="form-control" placeholder="Dining / Travel / Shopping" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Discount / Promo Code</label>
                        <input type="text" name="DiscountCode" class="form-control" placeholder="BTBZOM15" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Description</label>
                        <textarea name="Description" class="form-control" rows="2" required></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Valid Till</label>
                        <input type="date" name="ValidTill" class="form-control" value="@DateTime.Today.AddMonths(3).ToString("yyyy-MM-dd")" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-btb-gold">Save Offer</button>
                </div>
            </form>
        </div>
    </div>
</div>
