@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    var session = HttpContextAccessor.HttpContext?.Session;
    bool isLoggedIn = SessionHelper.IsLoggedIn(session!);
    string? userRole = SessionHelper.GetUserRole(session!);
    string? userFullName = SessionHelper.GetFullName(session!);
    string? username = SessionHelper.GetUsername(session!);
}
<!DOCTYPE html>
<html lang="en" style="background:#03080f;">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — BharatBank Admin Portal</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Inter:wght@300;400;500;600;700;800&family=Outfit:wght@500;600;700;800;900&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Three.js (Optional 3D Scene Runtime) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/overrides.css" asp-append-version="true" />
    <style>
        .admin-layout-wrapper {
            display: flex;
            min-height: 100vh;
        }
        
        .admin-sidebar {
            width: 250px;
            background: #09090b;
            border-right: 1px solid #27272a;
            display: flex;
            flex-direction: column;
            position: fixed;
            height: 100vh;
            z-index: 1040;
            transition: all 0.3s ease;
        }

        .admin-main-content {
            flex-grow: 1;
            margin-left: 250px;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            position: relative;
            z-index: 1;
        }

        .admin-nav-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 16px;
            color: #a1a1aa;
            text-decoration: none;
            border-radius: 8px;
            margin: 2px 12px;
            transition: all 0.2s ease;
            font-size: 0.875rem;
            font-weight: 500;
        }

        .admin-nav-link:hover {
            background: rgba(255, 255, 255, 0.05);
            color: #e4e4e7;
        }
        
        .admin-nav-link.active {
            background: rgba(99, 102, 241, 0.15); /* Indigo tint */
            color: #818cf8; /* Light Indigo */
        }

        .admin-nav-link i {
            font-size: 1.1rem;
        }
        
        .admin-topbar {
            background: #09090b;
            border-bottom: 1px solid #27272a;
            padding: 12px 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 1030;
        }
    </style>
</head>
<body>
    <!-- Fixed Background Canvas for Cinematic Galaxy & Stars -->
    <canvas id="bg-canvas" style="position:fixed; top:0; left:0; width:100vw; height:100vh; pointer-events:none; z-index:0;"></canvas>
    
    <div class="admin-layout-wrapper">
        <!-- Sidebar -->
        <nav class="admin-sidebar shadow-lg">
            <div class="d-flex align-items-center gap-2 p-4">
                <div class="bank-logo-icon">
                    <i class="bi bi-bank2"></i>
                </div>
                <div>
                    <h5 class="mb-0 fw-bold text-white" style="font-family:var(--font-brand);">BharatBank</h5>
                    <small class="text-warning" style="font-size: 0.7rem;">Admin Command Center</small>
                </div>
            </div>

            <div class="d-flex flex-column flex-grow-1 overflow-auto mt-2 pb-4">
                <small class="text-uppercase px-4 mb-2 text-muted fw-bold" style="font-size: 0.7rem; letter-spacing: 1px;">Master Controls</small>
                <a class="admin-nav-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-grid-fill"></i> Dashboard
                </a>
                <a class="admin-nav-link" asp-area="Admin" asp-controller="Users" asp-action="Index">
                    <i class="bi bi-people-fill"></i> Users & Staff
                </a>
                <a class="admin-nav-link" asp-area="Admin" asp-controller="Advertisements" asp-action="Index">
                    <i class="bi bi-badge-ad-fill"></i> Banners & Ads
                </a>
                <a class="admin-nav-link" asp-area="Admin" asp-controller="Content" asp-action="Index">
                    <i class="bi bi-layout-text-window-reverse"></i> Content & FAQs
                </a>
                <a class="admin-nav-link" asp-area="Admin" asp-controller="Rates" asp-action="Index">
                    <i class="bi bi-currency-exchange"></i> Rates & Currency
                </a>

                <small class="text-uppercase px-4 mb-2 mt-4 text-muted fw-bold" style="font-size: 0.7rem; letter-spacing: 1px;">Security & Reporting</small>
                <a class="admin-nav-link" asp-area="Admin" asp-controller="AuditLogs" asp-action="Index">
                    <i class="bi bi-fingerprint"></i> Audit Logs
                </a>
                <a class="admin-nav-link" asp-area="Admin" asp-controller="Reports" asp-action="Index">
                    <i class="bi bi-printer-fill"></i> Reports
                </a>
                <a class="admin-nav-link" asp-area="Admin" asp-controller="Settings" asp-action="Index">
                    <i class="bi bi-gear-fill"></i> System Settings
                </a>
            </div>

            <!-- Sidebar Footer Profile -->
            <div class="p-3 m-3 rounded-3" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1);">
                <div class="d-flex align-items-center gap-2 mb-2 text-light">
                    <i class="bi bi-person-circle fs-4 text-warning"></i>
                    <div style="line-height: 1.2;">
                        <div class="fw-bold small">@userFullName</div>
                        <div class="text-muted" style="font-size: 0.7rem;">@username</div>
                    </div>
                </div>
                <a asp-area="" asp-controller="Account" asp-action="Logout" class="btn btn-sm btn-outline-danger w-100 py-1">
                    <i class="bi bi-box-arrow-right"></i> Secure Logout
                </a>
            </div>
        </nav>

        <!-- Main Content Wrapper -->
        <div class="admin-main-content">
            <!-- Top Navbar -->
            <header class="admin-topbar">
                <div class="d-flex align-items-center">
                    <h5 class="mb-0 text-white fw-bold d-none d-md-block">@ViewData["Title"]</h5>
                </div>
                
                <div class="d-flex align-items-center gap-3">
                    <div class="text-end d-none d-sm-block me-2">
                        <div class="text-light small fw-bold">SysAdmin Mode Active</div>
                        <div class="text-success small"><i class="bi bi-shield-check"></i> System Secure</div>
                    </div>
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-outline-light btn-sm" title="Go to Main Website">
                        <i class="bi bi-box-arrow-up-right me-1"></i> Public Site
                    </a>
                </div>
            </header>

            <!-- Main Page Content -->
            <main class="flex-grow-1 p-4 pb-5">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show shadow-sm d-flex align-items-center gap-2" role="alert">
                        <i class="bi bi-check-circle-fill fs-5"></i>
                        <div>@TempData["SuccessMessage"]</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show shadow-sm d-flex align-items-center gap-2" role="alert">
                        <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                        <div>@TempData["ErrorMessage"]</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @RenderBody()
            </main>
            
            <footer class="p-3 text-center border-top" style="border-color: rgba(255,255,255,0.1) !important; background: rgba(3,8,15,0.9);">
                <small class="text-muted">&copy; 2026 BharatBank Admin System. Simulated SECURE environment.</small>
            </footer>
        </div>
    </div>

    <!-- Required Libraries -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/cinematic.js" asp-append-version="true"></script>
    <script>
        // Set active nav link dynamically
        $(document).ready(function() {
            var currentUrl = window.location.pathname;
            $('.admin-nav-link').each(function() {
                if (currentUrl === $(this).attr('href')) {
                    $(this).addClass('active');
                }
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
