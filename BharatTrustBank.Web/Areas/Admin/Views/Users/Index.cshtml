@model List<User>
@{
    ViewData["Title"] = "Staff & User Management";
    string selectedRole = ViewBag.SelectedRole as string ?? "All";
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-0">Staff & Customer User Directory</h2>
            <p class="text-muted small">Manage role permissions, account activation, password resets, and lockout clearances</p>
        </div>
        <button class="btn btn-btb-primary" data-bs-toggle="modal" data-bs-target="#createStaffModal">
            <i class="bi bi-person-plus-fill me-1"></i> Add New Employee / Manager
        </button>
    </div>

    <!-- Role Filters -->
    <div class="d-flex gap-2 mb-4">
        <a asp-action="Index" asp-route-role="" class="btn btn-sm @(selectedRole == "All" ? "btn-btb-primary" : "btn-outline-secondary")">All Users (@Model.Count)</a>
        <a asp-action="Index" asp-route-role="Customer" class="btn btn-sm @(selectedRole == "Customer" ? "btn-btb-primary" : "btn-outline-secondary")">Customers</a>
        <a asp-action="Index" asp-route-role="Employee" class="btn btn-sm @(selectedRole == "Employee" ? "btn-btb-primary" : "btn-outline-secondary")">Employees</a>
        <a asp-action="Index" asp-route-role="Manager" class="btn btn-sm @(selectedRole == "Manager" ? "btn-btb-primary" : "btn-outline-secondary")">Managers</a>
        <a asp-action="Index" asp-route-role="Admin" class="btn btn-sm @(selectedRole == "Admin" ? "btn-btb-primary" : "btn-outline-secondary")">Admins</a>
    </div>

    <!-- Users Table -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bank table-hover mb-0">
                    <thead>
                        <tr>
                            <th>User ID & Username</th>
                            <th>Full Name & Email</th>
                            <th>Mobile Number</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th>Lockout State</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in Model)
                        {
                            <tr>
                                <td>
                                    <strong class="text-dark">@u.Username</strong><br />
                                    <small class="text-muted font-monospace">UID-#@u.UserId</small>
                                </td>
                                <td>
                                    @u.FullName<br />
                                    <small class="text-muted">@u.Email</small>
                                </td>
                                <td class="font-monospace small">@u.MobileNumber</td>
                                <td>
                                    <span class="badge @(u.Role == "Admin" ? "bg-primary" : (u.Role == "Manager" ? "bg-success" : (u.Role == "Employee" ? "bg-info text-dark" : "bg-warning text-dark"))) fs-6">
                                        @u.Role
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @(u.IsActive ? "bg-success" : "bg-danger")">
                                        @(u.IsActive ? "Active" : "Deactivated")
                                    </span>
                                </td>
                                <td>
                                    @if (u.IsLocked)
                                    {
                                        <span class="badge bg-danger">Locked (Failed Attempts: @u.FailedLoginAttempts)</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Unlocked</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <form asp-action="ToggleUserActive" method="post">
                                            <input type="hidden" name="userId" value="@u.UserId" />
                                            <input type="hidden" name="currentActive" value="@u.IsActive" />
                                            <button type="submit" class="btn btn-sm @(u.IsActive ? "btn-outline-danger" : "btn-outline-success")" title="Toggle Active">
                                                <i class="bi @(u.IsActive ? "bi-person-dash" : "bi-person-check")"></i>
                                            </button>
                                        </form>

                                        @if (u.IsLocked)
                                        {
                                            <form asp-action="UnlockUser" method="post">
                                                <input type="hidden" name="userId" value="@u.UserId" />
                                                <button type="submit" class="btn btn-sm btn-warning" title="Unlock Account">
                                                    <i class="bi bi-unlock-fill"></i> Unlock
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Create Staff Modal -->
<div class="modal fade" id="createStaffModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold text-dark"><i class="bi bi-person-badge text-primary me-2"></i> Onboard New Staff</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateStaff" method="post">
                <div class="modal-body">
                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Full Name</label>
                            <input type="text" name="fullName" class="form-control" placeholder="e.g. Vikram Verma" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Role</label>
                            <select name="role" class="form-select">
                                <option value="Employee">Employee (Operations)</option>
                                <option value="Manager">Manager (Branch Head)</option>
                            </select>
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Username</label>
                            <input type="text" name="username" class="form-control" placeholder="e.g. emp.vikram" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Email</label>
                            <input type="email" name="email" class="form-control" placeholder="vikram@bharattrustbank.com" required />
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Mobile Number</label>
                            <input type="text" name="mobileNumber" class="form-control" placeholder="9820011223" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Password</label>
                            <input type="password" name="password" class="form-control" value="Password@123" required />
                        </div>
                    </div>

                    <div class="row g-2">
                        <div class="col-md-4">
                            <label class="form-label fw-bold small">Department</label>
                            <input type="text" name="department" class="form-control" value="Operations" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold small">Designation</label>
                            <input type="text" name="designation" class="form-control" value="Branch Officer" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold small">Salary (INR)</label>
                            <input type="number" name="salary" class="form-control" value="55000" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-btb-primary">Create Staff Account</button>
                </div>
            </form>
        </div>
    </div>
</div>
