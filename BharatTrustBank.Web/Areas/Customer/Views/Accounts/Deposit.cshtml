@model DepositWithdrawViewModel
@{
    ViewData["Title"] = "Simulated Cash Deposit";
}

<div class="container my-5" style="max-width: 650px;">
    <div class="card shadow p-4 p-md-5">
        <div class="d-flex align-items-center gap-3 border-bottom pb-3 mb-4">
            <div class="p-3 bg-success text-white rounded-3 fs-3">
                <i class="bi bi-cash-stack"></i>
            </div>
            <div>
                <h3 class="fw-bold mb-0">Simulated Cash Deposit</h3>
                <small class="text-muted">Directly credit your BharatTrust Bank account with demo funds</small>
            </div>
        </div>

        <form asp-action="Deposit" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small shadow-sm mb-3"></div>
            <input type="hidden" asp-for="TransactionType" />

            <div class="mb-3">
                <label asp-for="AccountId" class="form-label fw-bold small">Select Destination Account</label>
                <select asp-for="AccountId" class="form-select">
                    @foreach (var acc in Model.AvailableAccounts)
                    {
                        <option value="@acc.AccountId">@acc.AccountNumber - @acc.AccountTypeName (Balance: &#8377;@acc.Balance.ToString("N2"))</option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label asp-for="Amount" class="form-label fw-bold small">Deposit Amount (INR)</label>
                <div class="input-group">
                    <span class="input-group-text bg-light">&#8377;</span>
                    <input asp-for="Amount" class="form-control form-control-lg fs-5 fw-bold" placeholder="5000.00" />
                </div>
                <span asp-validation-for="Amount" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Description" class="form-label fw-bold small">Deposit Remarks</label>
                <input asp-for="Description" class="form-control" placeholder="e.g. Cash Deposit via CDM" />
            </div>

            <div class="d-flex justify-content-between align-items-center">
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn btn-success px-4 fw-bold">
                    <i class="bi bi-check-circle me-1"></i> Complete Deposit
                </button>
            </div>
        </form>
    </div>
</div>
