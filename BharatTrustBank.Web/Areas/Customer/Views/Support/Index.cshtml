@{
    ViewData["Title"] = "Customer Helpdesk & AI Banking Assistant";
    var tickets = ViewBag.Tickets as List<SupportTicket> ?? new List<SupportTicket>();
    var messages = ViewBag.ChatMessages as List<ChatMessage> ?? new List<ChatMessage>();
}

<div class="container my-5" style="max-width: 950px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-0">Customer Support & AI Assistant</h2>
            <p class="text-muted small">Raise customer care tickets, query our automated banking assistant, or chat with support</p>
        </div>
    </div>

    <div class="row g-4 mb-5">
        <!-- AI Banking Chatbot Simulation (Left Side) -->
        <div class="col-lg-6">
            <div class="card shadow h-100 d-flex flex-column">
                <div class="card-header bg-dark text-white d-flex align-items-center gap-2 py-3">
                    <i class="bi bi-robot fs-4 text-warning"></i>
                    <div>
                        <h6 class="mb-0 fw-bold">BharatBank Assistant</h6>
                        <small class="text-secondary" style="font-size: 0.72rem;">Instant AI Banking FAQs, Balances & Insights</small>
                    </div>
                </div>

                <!-- Chat Messages Stream Area -->
                <div class="card-body p-3 flex-grow-1 overflow-auto" id="chatStream" style="max-height: 380px; min-height: 300px; background: #f8fafc;">
                    <div class="d-flex mb-3">
                        <div class="p-3 bg-white text-dark rounded-3 shadow-sm border" style="max-width: 80%;">
                            <div class="small fw-bold text-primary mb-1">BharatBank Assistant</div>
                            <div class="small">Namaste! I can assist you with BharatBank account balances, recent transactions, cards, transfers, loans, or FDs.</div>
                        </div>
                    </div>

                    @foreach (var m in messages)
                    {
                        if (m.Sender == "Customer")
                        {
                            <div class="d-flex justify-content-end mb-3">
                                <div class="p-3 text-white rounded-3 shadow-sm" style="max-width: 80%; background: #0b2545;">
                                    <div class="small fw-bold text-warning mb-1">You</div>
                                    <div class="small">@m.Message</div>
                                    <div class="text-end" style="font-size: 0.65rem; opacity: 0.7;">@m.SentAt.ToString("hh:mm tt")</div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex mb-3">
                                <div class="p-3 bg-white text-dark rounded-3 shadow-sm border" style="max-width: 80%;">
                                    <div class="small fw-bold text-primary mb-1">BharatTrust AI Assistant</div>
                                    <div class="small">@m.Message</div>
                                    <div class="text-end text-muted" style="font-size: 0.65rem;">@m.SentAt.ToString("hh:mm tt")</div>
                                </div>
                            </div>
                        }
                    }
                </div>

                <!-- Chat Input Form -->
                <div class="card-footer bg-white p-2">
                    <form asp-action="SendChatMessage" method="post" class="d-flex gap-2">
                        <input type="text" name="userMessage" class="form-control" placeholder="Ask about transfers, FDs, loans..." required />
                        <button type="submit" class="btn btn-btb-primary px-3">
                            <i class="bi bi-send-fill"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Support Ticket Creation Form (Right Side) -->
        <div class="col-lg-6">
            <div class="card shadow p-4 h-100">
                <h5 class="fw-bold mb-3"><i class="bi bi-ticket-perforated-fill text-primary me-2"></i> Raise a Support Ticket</h5>
                <form asp-action="CreateTicket" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Category</label>
                        <select name="category" class="form-select">
                            <option value="Account">Account Maintenance & Statement</option>
                            <option value="Transfer">Funds Transfer / Payment Issue</option>
                            <option value="Cards">Debit & Credit Cards</option>
                            <option value="Loans">Loans & EMI Queries</option>
                            <option value="Other">General Customer Inquiry</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small">Subject</label>
                        <input type="text" name="subject" class="form-control" placeholder="e.g. Inquire about virtual card limit change" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small">Priority</label>
                        <select name="priority" class="form-select">
                            <option value="Low">Low</option>
                            <option value="Normal" selected>Normal</option>
                            <option value="High">High (Urgent Attention)</option>
                        </select>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold small">Detailed Message</label>
                        <textarea name="message" class="form-control" rows="4" placeholder="Please provide details..." required></textarea>
                    </div>

                    <button type="submit" class="btn btn-btb-gold w-100 fw-bold py-2 shadow-sm">
                        <i class="bi bi-send-check me-1"></i> Submit Ticket
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Active Tickets Status List -->
    <div class="card shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0 fw-bold"><i class="bi bi-list-task text-primary me-2"></i> My Support Tickets History</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bank table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Ticket No</th>
                            <th>Subject & Category</th>
                            <th>Date</th>
                            <th>Priority</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (tickets.Any())
                        {
                            @foreach (var t in tickets)
                            {
                                <tr>
                                    <td class="font-monospace fw-bold text-primary">@t.TicketNumber</td>
                                    <td>
                                        <strong class="text-dark">@t.Subject</strong><br />
                                        <small class="text-muted">@t.Category</small>
                                    </td>
                                    <td class="small">@t.CreatedAt.ToString("dd MMM yyyy")</td>
                                    <td><span class="badge @(t.Priority == "High" ? "bg-danger" : "bg-light text-dark border")">@t.Priority</span></td>
                                    <td>
                                        <span class="badge @(t.Status == "Resolved" || t.Status == "Closed" ? "bg-success" : "bg-warning text-dark")">
                                            @t.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="5" class="text-center py-4 text-muted">No support tickets found.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const stream = document.getElementById('chatStream');
            if (stream) {
                stream.scrollTop = stream.scrollHeight;
            }
        });
    </script>
}
