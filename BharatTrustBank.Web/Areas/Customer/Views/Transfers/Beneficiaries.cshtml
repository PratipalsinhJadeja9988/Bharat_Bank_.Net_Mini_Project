@model List<Beneficiary>
@{
    ViewData["Title"] = "Manage Beneficiaries";
}

<div class="container my-5" style="max-width: 900px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-0">Manage Beneficiaries</h2>
            <p class="text-muted small">Add and manage trusted payees for instant IMPS, NEFT, RTGS & UPI transfers</p>
        </div>
        <button class="btn btn-btb-primary" data-bs-toggle="modal" data-bs-target="#addBeneficiaryModal">
            <i class="bi bi-person-plus-fill me-1"></i> Add New Beneficiary
        </button>
    </div>

    <!-- Beneficiary Table -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bank table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Beneficiary Name</th>
                            <th>Bank Name</th>
                            <th>Account / UPI</th>
                            <th>IFSC Code</th>
                            <th>Transfer Mode</th>
                            <th>Max Limit</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var b in Model)
                            {
                                <tr>
                                    <td class="fw-bold">@b.BeneficiaryName</td>
                                    <td>@b.BankName</td>
                                    <td class="font-monospace">@b.AccountNumber</td>
                                    <td class="font-monospace small">@b.IFSCCode</td>
                                    <td><span class="badge bg-primary-subtle text-primary">@b.TransferType</span></td>
                                    <td class="fw-semibold">&#8377;@b.MaxLimit.ToString("N0")</td>
                                    <td>
                                        <form asp-action="DeleteBeneficiary" asp-route-id="@b.BeneficiaryId" method="post" onsubmit="return confirm('Are you sure you want to delete this beneficiary?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="7" class="text-center py-4 text-muted">No saved beneficiaries found.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Add Beneficiary Modal -->
<div class="modal fade" id="addBeneficiaryModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold text-dark"><i class="bi bi-person-plus-fill text-primary me-2"></i> Add Trusted Payee</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="AddBeneficiary" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Payee / Beneficiary Name</label>
                        <input type="text" name="BeneficiaryName" class="form-control" placeholder="e.g. Sneha Patel" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Bank Name</label>
                        <input type="text" name="BankName" class="form-control" placeholder="e.g. State Bank of India" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Account Number / UPI ID</label>
                        <input type="text" name="AccountNumber" class="form-control font-monospace" placeholder="100100xxxxxx" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small">IFSC Code</label>
                        <input type="text" name="IFSCCode" class="form-control text-uppercase font-monospace" placeholder="e.g. SBIN0000300" required />
                    </div>
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Transfer Type</label>
                            <select name="TransferType" class="form-select">
                                <option value="IMPS">IMPS</option>
                                <option value="NEFT">NEFT</option>
                                <option value="RTGS">RTGS</option>
                                <option value="UPI">UPI</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Per-Day Limit (INR)</label>
                            <input type="number" name="MaxLimit" class="form-control" value="50000" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-btb-primary">Add Beneficiary</button>
                </div>
            </form>
        </div>
    </div>
</div>
