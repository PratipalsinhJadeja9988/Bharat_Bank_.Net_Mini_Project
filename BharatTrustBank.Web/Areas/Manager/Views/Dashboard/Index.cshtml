@model ManagerDashboardViewModel
@{
    ViewData["Title"] = "Manager Business Intelligence Dashboard";
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-0">Manager Business Intelligence & Analytics</h2>
            <p class="text-muted small">Branch KPI metrics, deposit volumes, credit approvals, inactive accounts, and risk alerts</p>
        </div>
    </div>

    <!-- Manager KPI Metrics -->
    <div class="row g-3 mb-5">
        <div class="col-md-3">
            <div class="kpi-card kpi-blue">
                <div class="kpi-label">Branch Customers</div>
                <div class="kpi-val">@Model.TotalBranchCustomers</div>
                <small class="opacity-75">Active Portfolios</small>
            </div>
        </div>

        <div class="col-md-3">
            <div class="kpi-card kpi-gold">
                <div class="kpi-label">Branch Deposits</div>
                <div class="kpi-val">&#8377;@Model.TotalBranchDeposits.ToString("N0")</div>
                <small class="opacity-75">Total Customer Balance</small>
            </div>
        </div>

        <div class="col-md-3">
            <div class="kpi-card kpi-emerald">
                <div class="kpi-label">Active Loans Book</div>
                <div class="kpi-val">&#8377;@Model.TotalBranchLoans.ToString("N0")</div>
                <small class="opacity-75">Performing Assets</small>
            </div>
        </div>

        <div class="col-md-3">
            <div class="kpi-card kpi-purple">
                <div class="kpi-label">Inactive Accounts</div>
                <div class="kpi-val">@Model.InactiveAccountsCount</div>
                <small class="opacity-75">> 6 Months No Activity</small>
            </div>
        </div>
    </div>

    <!-- Charts & Analytics Row -->
    <div class="row g-4 mb-5">
        <div class="col-lg-8">
            <div class="card shadow-sm h-100 p-4">
                <h5 class="fw-bold mb-3"><i class="bi bi-graph-up-arrow text-primary me-2"></i> Branch Growth & Transaction Volumes</h5>
                <canvas id="branchTrendChart" style="max-height: 260px;"></canvas>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm h-100 p-4">
                <h5 class="fw-bold mb-3"><i class="bi bi-pie-chart-fill text-warning me-2"></i> Customer Segmentation</h5>
                <canvas id="segmentChart" style="max-height: 260px;"></canvas>
            </div>
        </div>
    </div>

    <!-- Pending Loan Applications Queue -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
            <h5 class="mb-0 fw-bold"><i class="bi bi-cash-stack text-success me-2"></i> Pending Loan Approvals (@Model.PendingLoanApprovals)</h5>
            <a asp-action="Index" asp-controller="LoanApprovals" class="small text-decoration-none">Full Queue <i class="bi bi-arrow-right"></i></a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bank table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Applicant</th>
                            <th>Loan Category</th>
                            <th>Amount</th>
                            <th>Tenure</th>
                            <th>Monthly Income</th>
                            <th>Credit Score</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.PendingLoans.Any())
                        {
                            @foreach (var l in Model.PendingLoans)
                            {
                                <tr>
                                    <td>
                                        <strong class="text-dark">@l.CustomerName</strong><br />
                                        <small class="text-muted font-monospace">LOAN-#@l.LoanId</small>
                                    </td>
                                    <td><span class="badge bg-primary-subtle text-primary">@l.LoanType</span></td>
                                    <td class="fw-bold text-dark">&#8377;@l.LoanAmount.ToString("N0")</td>
                                    <td>@l.TenureMonths Mos</td>
                                    <td>&#8377;@l.MonthlyIncome.ToString("N0")</td>
                                    <td><span class="badge bg-success fs-6">@l.CreditScore</span></td>
                                    <td>
                                        <form asp-action="ProcessLoan" asp-controller="LoanApprovals" method="post" class="d-inline">
                                            <input type="hidden" name="loanId" value="@l.LoanId" />
                                            <input type="hidden" name="status" value="Approved" />
                                            <input type="hidden" name="remarks" value="Approved by Branch Manager." />
                                            <button type="submit" class="btn btn-sm btn-success px-3">
                                                <i class="bi bi-check-lg"></i> Approve
                                            </button>
                                        </form>
                                        <form asp-action="ProcessLoan" asp-controller="LoanApprovals" method="post" class="d-inline ms-1">
                                            <input type="hidden" name="loanId" value="@l.LoanId" />
                                            <input type="hidden" name="status" value="Rejected" />
                                            <input type="hidden" name="remarks" value="Income criteria not satisfied." />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="7" class="text-center py-4 text-muted">No pending loan applications.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Trend Line Chart
            const trendCtx = document.getElementById('branchTrendChart').getContext('2d');
            new Chart(trendCtx, {
                type: 'line',
                data: {
                    labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug'],
                    datasets: [{
                        label: 'Deposits Growth (in Lakhs ₹)',
                        data: [45, 52, 58, 65, 72, 80, 88, 96],
                        borderColor: '#0b2545',
                        backgroundColor: 'rgba(11, 37, 69, 0.1)',
                        fill: true,
                        tension: 0.3
                    }]
                },
                options: { responsive: true }
            });

            // Segment Doughnut Chart
            const segCtx = document.getElementById('segmentChart').getContext('2d');
            new Chart(segCtx, {
                type: 'doughnut',
                data: {
                    labels: ['Premium Clients', 'Regular Savings', 'Corporate Salary', 'Business'],
                    datasets: [{
                        data: [35, 45, 12, 8],
                        backgroundColor: ['#d97706', '#0b2545', '#10b981', '#6d28d9']
                    }]
                },
                options: {
                    responsive: true,
                    plugins: { legend: { position: 'bottom', labels: { boxWidth: 10 } } }
                }
            });
        });
    </script>
}
