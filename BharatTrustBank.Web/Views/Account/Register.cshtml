@model RegisterViewModel
@{
    ViewData["Title"] = "Open Digital Bank Account";
}

<div class="container my-5" style="max-width: 900px;">
    <div class="card shadow p-4 p-md-5">
        <div class="d-flex align-items-center gap-3 pb-3 mb-4" style="border-bottom:1px solid var(--color-border);">
            <div class="p-3 rounded-3 fs-3" style="background:rgba(96,165,250,0.15); color:#60a5fa;">
                <i class="bi bi-person-vcard-fill"></i>
            </div>
            <div>
                <h3 class="fw-bold mb-0" style="font-family:var(--font-display); color:var(--color-on-surface);">Open Instant Digital Account</h3>
                <small style="color:var(--color-on-surface-secondary);">Simulated Indian NetBanking Registration with Virtual Debit Card &amp; &#8377;25,000 Welcome Balance</small>
            </div>
        </div>

        <form asp-action="Register" method="post" id="regForm">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small shadow-sm mb-4"></div>

            <div class="row g-3">
                <!-- Full Name -->
                <div class="col-md-6">
                    <label asp-for="FullName" class="form-label fw-bold small"></label>
                    <input asp-for="FullName" class="form-control" placeholder="e.g. Rahul Sharma" required />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <!-- Username -->
                <div class="col-md-6">
                    <label asp-for="Username" class="form-label fw-bold small"></label>
                    <input asp-for="Username" class="form-control" placeholder="e.g. rahul.sharma99" required />
                    <span asp-validation-for="Username" class="text-danger small"></span>
                </div>

                <!-- Email -->
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label fw-bold small"></label>
                    <input asp-for="Email" class="form-control" placeholder="rahul@example.com" required />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <!-- Mobile -->
                <div class="col-md-6">
                    <label asp-for="MobileNumber" class="form-label fw-bold small"></label>
                    <input asp-for="MobileNumber" class="form-control" placeholder="10-digit mobile" maxlength="10" required />
                    <span asp-validation-for="MobileNumber" class="text-danger small"></span>
                </div>

                <!-- DOB -->
                <div class="col-md-6">
                    <label asp-for="DateOfBirth" class="form-label fw-bold small"></label>
                    <input asp-for="DateOfBirth" class="form-control" type="date" required />
                    <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                </div>

                <!-- Gender -->
                <div class="col-md-6">
                    <label asp-for="Gender" class="form-label fw-bold small"></label>
                    <select asp-for="Gender" class="form-select">
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                        <option value="Other">Other</option>
                    </select>
                </div>

                <!-- Address -->
                <div class="col-12">
                    <label asp-for="Address" class="form-label fw-bold small"></label>
                    <input asp-for="Address" class="form-control" placeholder="Flat No, Building, Street, Area" required />
                    <span asp-validation-for="Address" class="text-danger small"></span>
                </div>

                <!-- City -->
                <div class="col-md-4">
                    <label asp-for="City" class="form-label fw-bold small"></label>
                    <input asp-for="City" class="form-control" placeholder="e.g. Mumbai" required />
                </div>

                <!-- State -->
                <div class="col-md-4">
                    <label asp-for="State" class="form-label fw-bold small"></label>
                    <input asp-for="State" class="form-control" placeholder="e.g. Maharashtra" required />
                </div>

                <!-- Pincode -->
                <div class="col-md-4">
                    <label asp-for="Pincode" class="form-label fw-bold small"></label>
                    <input asp-for="Pincode" class="form-control" placeholder="6-digit PIN" maxlength="6" required />
                    <span asp-validation-for="Pincode" class="text-danger small"></span>
                </div>

                <!-- PAN Card -->
                <div class="col-md-6">
                    <label asp-for="PAN" class="form-label fw-bold small"></label>
                    <input asp-for="PAN" class="form-control text-uppercase" placeholder="e.g. ABCDE1234F" maxlength="10" required />
                    <span asp-validation-for="PAN" class="text-danger small"></span>
                </div>

                <!-- Aadhaar Card -->
                <div class="col-md-6">
                    <label asp-for="Aadhaar" class="form-label fw-bold small"></label>
                    <input asp-for="Aadhaar" class="form-control" placeholder="e.g. 2345 6789 0123" maxlength="14" required />
                    <span asp-validation-for="Aadhaar" class="text-danger small"></span>
                </div>

                <!-- Account Type Selection -->
                <div class="col-md-6">
                    <label asp-for="AccountTypeId" class="form-label fw-bold small"></label>
                    <select asp-for="AccountTypeId" class="form-select">
                        <option value="1">Regular Savings Account (4.00% p.a.)</option>
                        <option value="2">Commercial Current Account (0.00% p.a.)</option>
                        <option value="3">Corporate Salary Account (4.25% p.a.)</option>
                    </select>
                </div>

                <!-- Nominee -->
                <div class="col-md-6">
                    <label class="form-label fw-bold small">Nominee Name & Relation (Optional)</label>
                    <div class="input-group">
                        <input asp-for="NomineeName" class="form-control" placeholder="Nominee Full Name" />
                        <input asp-for="NomineeRelation" class="form-control" placeholder="Relation (e.g. Spouse)" />
                    </div>
                </div>

                <!-- Password -->
                <div class="col-md-6">
                    <label asp-for="Password" class="form-label fw-bold small"></label>
                    <input asp-for="Password" class="form-control" placeholder="Minimum 6 characters" required />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <!-- Confirm Password -->
                <div class="col-md-6">
                    <label asp-for="ConfirmPassword" class="form-label fw-bold small"></label>
                    <input asp-for="ConfirmPassword" class="form-control" placeholder="Re-type password" required />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <!-- Simulated OTP Input Section -->
                <div class="col-12 p-3 rounded-3" style="background:var(--glass-bg); border:1px solid var(--color-border);">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label class="form-label fw-semibold small mb-0" style="color:var(--color-on-surface);">
                            <i class="bi bi-shield-check me-1" style="color:var(--color-accent);"></i> Simulated 2-Factor Mobile OTP Verification
                        </label>
                        <span class="badge bg-success">Simulated OTP: 123456</span>
                    </div>
                    <div class="input-group" style="max-width: 320px;">
                        <input type="text" name="simulatedOtp" id="simulatedOtp" class="form-control text-center fw-bold fs-5" placeholder="123456" maxlength="6" value="123456" required />
                        <button type="button" class="btn btn-outline-secondary" onclick="alert('Simulated SMS OTP sent: 123456')">Resend OTP</button>
                    </div>
                </div>

                <!-- Accept Terms -->
                <div class="col-12">
                    <div class="form-check">
                        <input asp-for="AcceptTerms" class="form-check-input" id="AcceptTerms" />
                        <label asp-for="AcceptTerms" class="form-check-label small" style="color:var(--color-on-surface-secondary);">
                            I declare that the information provided is accurate and agree to BharatBank's 
                            <a href="javascript:void(0);" data-bs-toggle="modal" data-bs-target="#termsModal" onclick="event.stopPropagation();" style="color:var(--color-accent, #60a5fa); text-decoration:underline; font-weight:600;">Terms &amp; Conditions</a>.
                        </label>
                    </div>
                    <span asp-validation-for="AcceptTerms" class="text-danger small"></span>
                </div>

                <!-- Submit Button -->
                <div class="col-12 mt-4 text-center">
                    <button type="submit" class="btn btn-btb-gold btn-lg px-5 fw-bold shadow-sm">
                        <i class="bi bi-check2-circle me-2"></i> Submit Registration & Open Account
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Terms & Conditions Modal -->
<div class="modal fade" id="termsModal" tabindex="-1" aria-labelledby="termsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content" style="background:var(--color-surface, #1e222d); color:var(--color-on-surface, #ffffff); border:1px solid var(--color-border, rgba(255,255,255,0.1));">
            <div class="modal-header border-0 pb-0">
                <div class="d-flex align-items-center gap-2">
                    <div class="p-2 rounded-3 fs-4" style="background:rgba(96,165,250,0.15); color:#60a5fa;">
                        <i class="bi bi-file-earmark-lock2-fill"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold mb-0" id="termsModalLabel">Terms &amp; Conditions</h5>
                        <small style="color:var(--color-on-surface-secondary, #94a3b8);">BharatBank Academic Simulation User Agreement</small>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4">
                <!-- Academic Disclaimer -->
                <div class="p-3 rounded-3 d-flex align-items-start gap-3 mb-3" style="background:rgba(255,215,0,0.08); border:1px solid rgba(255,215,0,0.25);">
                    <i class="bi bi-shield-exclamation fs-4" style="color:var(--color-gold, #f59e0b);"></i>
                    <div>
                        <strong class="d-block mb-1">Mandatory Project Disclaimer:</strong>
                        <p class="mb-0 small" style="color:var(--color-on-surface-secondary, #94a3b8); line-height:1.6;">
                            "This application is an academic banking simulation developed for educational purposes.
                            It does not process real financial transactions or connect to real banking infrastructure."
                        </p>
                    </div>
                </div>

                <div class="p-3 rounded-3" style="max-height:260px; overflow-y:auto; font-size:0.875rem; line-height:1.7; background:rgba(0,0,0,0.2); border:1px solid var(--color-border, rgba(255,255,255,0.08));">
                    <h6 class="fw-bold mb-1">1. Academic Use and Simulation Nature</h6>
                    <p class="text-secondary mb-3">BharatBank is developed solely for academic coursework, practical examination, and viva demonstration. All account balances, transactions, and services are purely simulated.</p>

                    <h6 class="fw-bold mb-1">2. No Real Monetary Processing</h6>
                    <p class="text-secondary mb-3">Under no circumstances does this application interact with the Reserve Bank of India (RBI), Real Time Gross Settlement (RTGS), National Electronic Funds Transfer (NEFT), Unified Payments Interface (UPI), or any actual financial institution.</p>

                    <h6 class="fw-bold mb-1">3. Simulated Security &amp; Confidentiality</h6>
                    <p class="text-secondary mb-3">Demo credentials (such as username, passwords, simulated OTPs, PAN numbers, and Aadhaar numbers) are stored for local demonstration. Never enter real banking passwords or actual credit/debit card credentials.</p>

                    <h6 class="fw-bold mb-1">4. Role-Based Access Control &amp; Auditing</h6>
                    <p class="text-secondary mb-0">Users must adhere to the role assignments (Customer, Employee, Manager, Admin). Any unauthorized attempts are logged in the simulated Audit Log system.</p>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0 d-flex justify-content-between align-items-center">
                <a asp-controller="Home" asp-action="Terms" target="_blank" class="small text-decoration-none" style="color:var(--color-accent, #60a5fa);">
                    <i class="bi bi-box-arrow-up-right me-1"></i> Open full terms in new tab
                </a>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm px-3" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn btn-btb-gold btn-sm px-4 fw-bold" id="btnModalAcceptTerms">
                        <i class="bi bi-check2-circle me-1"></i> I Agree &amp; Accept
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            // Register unobtrusive validator for MustBeTrue
            if ($.validator && $.validator.unobtrusive) {
                $.validator.addMethod("mustbetrue", function (value, element) {
                    return $(element).is(":checked");
                }, "You must accept Terms and Conditions to register");
                $.validator.unobtrusive.adapters.addBool("mustbetrue");
            }

            // Immediately re-validate when checkbox state changes
            $('#AcceptTerms').on('change', function () {
                $(this).valid();
            });

            // Modal 'I Agree & Accept' button
            $('#btnModalAcceptTerms').on('click', function () {
                var chk = $('#AcceptTerms');
                chk.prop('checked', true);
                chk.valid();
                var modalEl = document.getElementById('termsModal');
                var modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
                modal.hide();
            });
        });
    </script>
}
