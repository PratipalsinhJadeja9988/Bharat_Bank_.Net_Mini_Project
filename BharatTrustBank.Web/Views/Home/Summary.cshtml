@{
    ViewData["Title"] = "Bank Summary & Academic Simulation Overview";
}

<div class="container my-5">
    <!-- Header -->
    <div class="text-center mb-5">
        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill fw-semibold small mb-3"
             style="background:rgba(96,165,250,0.12); color:#93c5fd; border:1px solid rgba(96,165,250,0.25);">
            <i class="bi bi-mortarboard-fill"></i> .NET Mini Project Master Architecture
        </div>
        <div class="section-gold-line"></div>
        <h1 class="fw-bold display-5" style="font-family:var(--font-display); color:var(--color-on-surface);">
            About BharatBank
        </h1>
        <p class="lead mx-auto" style="max-width:750px; color:var(--color-on-surface-secondary);">
            A premier full-featured Indian Online Banking Simulation designed to demonstrate core C#, ASP.NET MVC,
            Web Forms, ADO.NET, SQL Server, and REST API practical concepts.
        </p>
    </div>

    <!-- Academic Disclaimer Card (Mandatory Verbatim Text) -->
    <div class="card mb-5 p-4 rounded-4" style="background:rgba(255,215,0,0.07)!important; border:1px solid rgba(255,215,0,0.28)!important;">
        <div class="d-flex align-items-start gap-3">
            <div class="fs-1" style="color:var(--color-gold);"><i class="bi bi-exclamation-triangle-fill"></i></div>
            <div>
                <h4 class="fw-bold mb-1" style="color:var(--color-on-surface);">Academic Simulation Notice</h4>
                <p class="mb-0" style="line-height:1.7; color:var(--color-on-surface-secondary);">
                    "This application is an academic banking simulation developed for educational purposes.
                    It does not process real financial transactions or connect to real banking infrastructure."
                </p>
            </div>
        </div>
    </div>

    <!-- Core Banking Features Matrix (3D Tilt Cards) -->
    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="tilt-card h-100">
                <div class="card h-100 p-4">
                    <div class="fs-2 mb-3" style="color:#60a5fa;"><i class="bi bi-person-badge-fill"></i></div>
                    <h5 class="fw-bold" style="font-family:var(--font-brand); color:var(--color-on-surface);">4 Role-Based Portals</h5>
                    <p class="small mb-0" style="color:var(--color-on-surface-secondary);">
                        Separate dashboards and distinct security permissions for <strong style="color:var(--color-on-surface);">Customer</strong>,
                        <strong style="color:var(--color-on-surface);">Employee</strong>,
                        <strong style="color:var(--color-on-surface);">Manager</strong>, and
                        <strong style="color:var(--color-on-surface);">Administrator</strong>
                        with complete prevention of unauthorized URL access.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="tilt-card h-100">
                <div class="card h-100 p-4">
                    <div class="fs-2 mb-3" style="color:var(--color-accent);"><i class="bi bi-arrow-left-right"></i></div>
                    <h5 class="fw-bold" style="font-family:var(--font-brand); color:var(--color-on-surface);">ACID Banking Transactions</h5>
                    <p class="small mb-0" style="color:var(--color-on-surface-secondary);">
                        Simulated fund transfers via IMPS, NEFT, RTGS, UPI with real-time balance deductions,
                        beneficiary management, OTP validation, and downloadable transaction receipts.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="tilt-card h-100">
                <div class="card h-100 p-4">
                    <div class="fs-2 mb-3" style="color:var(--color-gold);"><i class="bi bi-pie-chart-fill"></i></div>
                    <h5 class="fw-bold" style="font-family:var(--font-brand); color:var(--color-on-surface);">Financial Visual Analytics</h5>
                    <p class="small mb-0" style="color:var(--color-on-surface-secondary);">
                        Dynamic Chart.js analytics for monthly expense trends, income vs. expenses, savings progress,
                        rule-based credit scoring, and personalized financial tips.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="tilt-card h-100">
                <div class="card h-100 p-4">
                    <div class="fs-2 mb-3" style="color:var(--color-error);"><i class="bi bi-shield-lock-fill"></i></div>
                    <h5 class="fw-bold" style="font-family:var(--font-brand); color:var(--color-on-surface);">Security &amp; Fraud Detection</h5>
                    <p class="small mb-0" style="color:var(--color-on-surface-secondary);">
                        SHA-256 password hashing with salt, 5-attempt account locking, login history audits,
                        device tracking, and automated rule-based fraud detection.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="tilt-card h-100">
                <div class="card h-100 p-4">
                    <div class="fs-2 mb-3" style="color:#67e8f9;"><i class="bi bi-robot"></i></div>
                    <h5 class="fw-bold" style="font-family:var(--font-brand); color:var(--color-on-surface);">Dual AI Chatbot Engine</h5>
                    <p class="small mb-0" style="color:var(--color-on-surface-secondary);">
                        Dedicated <strong style="color:var(--color-on-surface);">Customer Assistant</strong> for account queries &amp; FAQs and
                        <strong style="color:var(--color-on-surface);">Operations Assistant</strong> for Manager/Admin branch statistics
                        with strict tool permission boundaries.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="tilt-card h-100">
                <div class="card h-100 p-4">
                    <div class="fs-2 mb-3" style="color:var(--color-on-surface-secondary);"><i class="bi bi-code-slash"></i></div>
                    <h5 class="fw-bold" style="font-family:var(--font-brand); color:var(--color-on-surface);">REST API &amp; ADO.NET Demo</h5>
                    <p class="small mb-0" style="color:var(--color-on-surface-secondary);">
                        ASP.NET Core REST API with Swagger documentation along with a dedicated ADO.NET direct database
                        CRUD demonstration for syllabus compliance.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="d-flex justify-content-center gap-3 flex-wrap">
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary px-4 py-2">
            <i class="bi bi-arrow-left me-1"></i> Back to Home
        </a>
        <a asp-controller="Home" asp-action="Terms" class="btn btn-btb-primary px-5 py-2 fw-bold shadow">
            Next: Terms &amp; Conditions <i class="bi bi-arrow-right ms-1"></i>
        </a>
    </div>
</div>
